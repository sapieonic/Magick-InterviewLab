# ---------------------------------------------------------------------------
# MagicVoice InterviewLab — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Required when running on the host
# (`npm run dev` / `npm start`).
#
# Leave it commented out if you use `docker compose up`: compose reads this
# file for ${VAR} interpolation, and a localhost URL here would be handed to
# the app *container*, where nothing is listening on 5432. Compose points the
# app at the `db` service itself.
#
# The port here (5432) is for a Postgres you run yourself. If instead you run
# ONLY the compose `db` service and the app on the host (`docker compose up -d
# db`), that service is published on host port 5433 — use `localhost:5433`.
DATABASE_URL="postgresql://interviewlab:interviewlab@localhost:5432/interviewlab?schema=public"

# --- Bootstrap admin -------------------------------------------------------
# The first admin account is created on startup (and by `npm run db:seed`) if
# it does not already exist. Provide a HASH, not a plaintext password:
#   npm run hash-password -- 'your-password-here'
# ADMIN_PASSWORD (plaintext) is also accepted but only as a development
# convenience; it is refused when NODE_ENV=production.
ADMIN_EMAIL="admin@magicvoice.local"
ADMIN_PASSWORD_HASH=""
# ADMIN_PASSWORD="dev-only-plaintext"
ADMIN_NAME="MagicVoice Admin"

# --- Sessions --------------------------------------------------------------
# Lifetime of a login session, in hours.
SESSION_TTL_HOURS="12"
# Set to "true" to force the Secure cookie flag when terminating TLS upstream.
# Left unset, Secure is enabled automatically when NODE_ENV=production.
# COOKIE_SECURE="true"

# --- Seed data (development only) -----------------------------------------
# `npm run db:seed` creates a demo interview, questions and one candidate.
# The candidate's password comes from here; if unset, a random one is
# generated and printed once to the console.
SEED_CANDIDATE_EMAIL="candidate@magicvoice.local"
# SEED_CANDIDATE_PASSWORD=""
# Set to "false" to seed only the admin account.
SEED_DEMO_DATA="true"

# --- Outbound email (Mailjet) ---------------------------------------------
# Optional. Leave all three unset and the app runs with email off: the
# "email the sign-in details" checkbox is simply not offered and candidate
# passwords are handed over out of band, as before.
#
# Set ALL THREE to enable it. A partial configuration is refused at startup
# rather than silently never sending, and so is a NEXT_PUBLIC_APP_URL still
# pointing at localhost — every invitation links to it, so a loopback value
# mails each candidate a link nobody can follow. Keys are at
# https://app.mailjet.com/account/apikeys — the sender must be a Mailjet
# verified sender or a verified domain, or every send is rejected.
# MAILJET_API_KEY=""
# MAILJET_API_SECRET=""
# MAIL_FROM_EMAIL="interviews@yourdomain.com"

# Display name on the From header. Defaults to "<NEXT_PUBLIC_APP_NAME>
# InterviewLab", so a rebranded deployment does not send its own subject line
# from someone else's name.
# MAIL_FROM_NAME="Acme Talent"
# Where candidate replies go, if not the From address.
# MAIL_REPLY_TO="talent@yourdomain.com"
# "true" makes Mailjet authenticate and validate every message but deliver
# nothing — the way to exercise this against the real API in staging. Blank
# is read as "false", not as a configuration error.
# MAILJET_SANDBOX="false"

# --- Public (browser-visible) ---------------------------------------------
NEXT_PUBLIC_APP_NAME="MagicVoice"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Where the Pyodide WebAssembly runtime is loaded from. Override to self-host.
NEXT_PUBLIC_PYODIDE_INDEX_URL="https://cdn.jsdelivr.net/pyodide/v314.0.6/full/"

# --- Runtime / operations ---------------------------------------------------
# Port the server listens on. Defaults to 3000.
# PORT="3000"
# Docker entrypoint only: run `prisma migrate deploy` on container start.
# RUN_MIGRATIONS="true"
# Docker entrypoint only: also run the seed on container start.
# RUN_SEED="false"
# Docker entrypoint only: how many times to retry the migration while the
# database finishes starting.
# MIGRATE_MAX_ATTEMPTS="10"

# --- Tooling (not read by the application) ---------------------------------
# `npm run test:e2e`: point Playwright at an already-running server, or at a
# preinstalled Chromium whose revision differs from the pinned Playwright.
# E2E_PORT="3100"
# E2E_BASE_URL="http://127.0.0.1:3100"
# E2E_CHROMIUM_PATH=""
# `npm run fetch:pyodide`: which runtime to stage into public/pyodide.
# PYODIDE_VERSION="v314.0.6"
# PYODIDE_SOURCE_URL=""
